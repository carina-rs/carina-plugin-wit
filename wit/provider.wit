interface provider {
    use types.{
        resource-id,
        state,
        read-outcome,
        persisted-state,
        create-step,
        create-verdict,
        pending-create,
        poll-verdict,
        resume-pending,
        resume-step,
        resume-verdict,
        update-outcome,
        delete-outcome,
        pending-operation,
        resource-def,
        value,
        persisted-value,
        create-request,
        read-request,
        update-request,
        delete-request,
        provider-error,
        type-identity,
        binding-pattern,
    };

    enum plan-op {
        create,
        read,
        update,
        delete,
    }

    /// Returns JSON-serialized ProviderInfo
    info: func() -> string;

    /// Returns JSON-serialized Vec<ResourceSchema>
    schemas: func() -> string;

    /// Returns JSON-serialized HashMap<String, AttributeType> describing
    /// the provider block's configuration attributes (e.g., `region`).
    /// The host validates provider config against this schema before
    /// calling `validate-config`, so DSL format bugs in carina-core are
    /// fixed on the host without rebuilding providers.
    provider-config-attribute-types: func() -> string;

    validate-config: func(attrs: list<tuple<string, value>>) -> result<_, provider-error>;
    initialize: func(attrs: list<tuple<string, value>>) -> result<_, provider-error>;

    /// Read the current provider-side state of an existing resource.
    ///
    /// `identifier` is the validated, non-empty cloud-side identifier of a
    /// managed resource. Resources without saved state are not sent across
    /// this boundary. A successful existing-resource observation is returned
    /// as `found(applied-state)`, which also requires a non-empty identifier.
    ///
    /// `request` carries no operationally meaningful fields today; it
    /// exists so future fields (e.g. a freshness hint or an attribute
    /// projection) can be added without breaking the `read` signature.
    read: func(
        id: resource-id,
        identifier: string,
        request: read-request,
    ) -> result<read-outcome, provider-error>;

    /// Read a data source resource. Receives the full `resource-def` so
    /// providers can see user-supplied input attributes (e.g. the
    /// `user_name` for `aws.identitystore.user`). Zero-input data sources
    /// should still route through `read` on the host side — callers
    /// dispatch on `resource.is_data_source()` before picking this path.
    read-data-source: func(res: resource-def) -> result<state, provider-error>;

    /// Perform one short create step for the resource described by
    /// `request.res`. (`res` rather than `resource` because `resource` is a
    /// reserved keyword in WIT.) If the external operation has not settled,
    /// return `pending`; never wait or poll inside this call. Each call must
    /// finish well under the host's per-call hard timeout. An `untracked`
    /// verdict means nothing reached the cloud; `created` means a resource
    /// exists and the host records a row for it.
    create: func(
        id: resource-id,
        request: create-request,
    ) -> result<create-step, create-verdict>;

    /// Perform one short poll step for a pending create. The host passes the
    /// original request on every poll. This may return `pending` again; never
    /// wait in-call. The token must be free of secrets and decodable by later
    /// releases of the same provider. `undetermined` means the provider cannot
    /// decide, for example because the token or request failed to decode, and
    /// the host keeps the in-flight row.
    poll-create: func(
        id: resource-id,
        request: create-request,
        pending: pending-create,
    ) -> result<create-step, poll-verdict>;

    /// Resume one short step of a create persisted by an earlier invocation.
    /// A resumed create carries no `sent`; the host uses the persisted
    /// envelope. Its token must be free of secrets and decodable by later
    /// releases of the same provider. `untracked` means nothing reached the
    /// cloud; `created` means a resource exists and the host records a row;
    /// and `undetermined` means the provider cannot decide, for example
    /// because the token or request failed to decode, so the host keeps the
    /// in-flight row.
    resume-create: func(
        id: resource-id,
        request: create-request,
        pending: resume-pending,
    ) -> result<resume-step, resume-verdict>;

    /// Update an existing resource by applying `request.patch`.
    ///
    /// Each `patch-op` corresponds to a key the user explicitly specified or
    /// removed in the desired state, or (for `reassert`) a desired write-only
    /// key re-sent alongside another change. Fields the user has never specified
    /// still never appear in the patch.
    ///
    /// Providers MUST NOT modify any attribute that is not represented in
    /// `request.patch.ops`. The patch is the sole source of truth for the
    /// update payload; the previous full `to: resource` parameter was
    /// removed because exposing the full desired resource invites
    /// providers to touch fields the user never specified (the root cause
    /// of `carina-rs/carina#2559`).
    ///
    /// `request.current` is persisted state and may contain redacted-secret
    /// digests, never secret plaintext. It may be used for read-modify-write
    /// paths or for resolving server-assigned identifiers, but redacted-secret
    /// digests MUST NOT be sent to the cloud and `current` MUST NOT be used to
    /// derive additional fields to write back. Providers MUST carry stored
    /// values not changed by `request.patch` forward as-is into the
    /// `update-outcome`. (Named `current` because `from` is a reserved keyword
    /// in WIT.)
    ///
    /// This export performs one short step. If the external operation has not
    /// settled, return `pending`; never wait or poll inside this call. Each
    /// call must finish well under the host's per-call hard timeout.
    update: func(
        id: resource-id,
        identifier: string,
        request: update-request,
    ) -> result<update-outcome, provider-error>;

    /// Perform one short poll step for a pending update. The host passes the
    /// original identifier and request on every poll. This may return
    /// `pending` again; never wait in-call, and never put request or secret
    /// data in the token.
    poll-update: func(
        id: resource-id,
        identifier: string,
        request: update-request,
        pending: pending-operation,
    ) -> result<update-outcome, provider-error>;

    /// Delete an existing resource.
    ///
    /// `request.directives` carries the resource's Carina-side
    /// directives (force-delete, create-before-destroy, prevent-destroy).
    /// Wrapping the parameter in a record lets future fields be added
    /// without breaking the `delete` signature.
    ///
    /// This export performs one short step. If the external operation has not
    /// settled, return `pending`; never wait or poll inside this call. Each
    /// call must finish well under the host's per-call hard timeout.
    delete: func(
        id: resource-id,
        identifier: string,
        request: delete-request,
    ) -> result<delete-outcome, provider-error>;

    /// Perform one short poll step for a pending delete. The host passes the
    /// original identifier and request on every poll. This may return
    /// `pending` again; never wait in-call, and never put request or secret
    /// data in the token.
    poll-delete: func(
        id: resource-id,
        identifier: string,
        request: delete-request,
        pending: pending-operation,
    ) -> result<delete-outcome, provider-error>;

    required-permissions: func(
        id: resource-id,
        operation: plan-op,
    ) -> list<string>;

    /// For a wait whose `until` predicate reads `attr-path` of the resource
    /// at `target-id`, return binding-name patterns describing which neighbor
    /// effects could mutate that attribute. The planner matches these patterns
    /// against the plan's bindings at plan time and adds the matched bindings
    /// to the wait's dependency set, so a wait whose satisfier set is empty
    /// or all-failed reports `unsatisfiable` at dispatch time instead of
    /// polling to timeout.
    ///
    /// Default behaviour is "no hint": return an empty list. Implement only
    /// for resource types where the carina-side dependency graph cannot
    /// infer the mutator relationship (e.g., ACM Certificate's `status`
    /// flipping to `issued` on creation of matching `route53.RecordSet`
    /// records).
    satisfier-hint: func(
        target-id: resource-id,
        attr-path: list<string>,
    ) -> list<binding-pattern>;

    /// Returns JSON-serialized HashMap<String, Vec<CompletionValue>> where key is
    /// the config attribute name (e.g., "region") and value is a list of completion
    /// candidates with { value, description }.
    provider-config-completions: func() -> string;

    /// Returns the list of identity attribute names used for anonymous resource
    /// ID computation (e.g., ["region"]).
    identity-attributes: func() -> list<string>;

    /// Validate a value against a provider-defined custom type.
    /// Returns Ok(()) if valid or the type is unknown.
    /// Returns Err(invalid-input(...)) if the value is invalid for the
    /// given type.
    ///
    /// `ty` is a structured `type-identity` rather than a flat string:
    /// the plugin matches on the discrete axes instead of splitting a
    /// dotted/snake-cased name, so two providers' same-named custom
    /// types never collide on lookup.
    validate-custom-type: func(ty: type-identity, value: string) -> result<_, provider-error>;

    /// Normalize desired resources before planning.
    ///
    /// Boundary conversion failures and provider normalization failures are
    /// returned as `provider-error`; traps are reserved for guest crashes.
    normalize-desired: func(
        resources: list<resource-def>,
    ) -> result<list<resource-def>, provider-error>;

    /// Normalize persisted resource states before they are consumed by the
    /// planner or executor.
    ///
    /// Boundary conversion failures and provider normalization failures are
    /// returned as `provider-error`; traps are reserved for guest crashes.
    normalize-state: func(
        states: list<tuple<string, persisted-state>>,
    ) -> result<list<tuple<string, persisted-state>>, provider-error>;

    /// Restore saved attributes into states returned by `read`.
    ///
    /// Boundary conversion failures and provider hydration failures are
    /// returned as `provider-error`; traps are reserved for guest crashes.
    hydrate-read-state: func(
        states: list<tuple<string, persisted-state>>,
        saved-attrs: list<tuple<string, list<tuple<string, persisted-value>>>>,
    ) -> result<list<tuple<string, persisted-state>>, provider-error>;

}

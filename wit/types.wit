interface types {
    record resource-id {
        provider: string,
        resource-type: string,
        name: string,
    }

    /// Attribute values serialized as JSON strings for complex/nested types.
    variant value {
        bool-val(bool),
        int-val(s64),
        float-val(f64),
        str-val(string),
        /// JSON-encoded array
        list-val(string),
        /// JSON-encoded object
        map-val(string),
        /// JSON-encoded inner value of a host-side secret. Provider plugins
        /// SHOULD treat the inner as the operational value (e.g. send it to
        /// the cloud API) but MUST NOT log or persist it. Plain providers
        /// that don't care about the distinction can decode it the same way
        /// they decode str-val/list-val/map-val. The host wraps the original
        /// value back into a Secret on the way out.
        secret-val(string),
    }

    record state {
        identifier: option<string>,
        attributes: list<tuple<string, value>>,
        exists: bool,
    }

    record resource-def {
        id: resource-id,
        attributes: list<tuple<string, value>>,
    }

    /// Kind of a single `patch-op`.
    ///
    /// `add` and `replace` carry `some(value)` on the patch-op; `remove`
    /// carries `none`.
    variant patch-op-kind {
        /// User added a key that did not previously appear in the desired state.
        add,
        /// User changed the value of an existing key in the desired state.
        replace,
        /// User removed a key that previously appeared in the desired state.
        remove,
    }

    record patch-op {
        kind: patch-op-kind,
        /// Top-level attribute name. Nested-field patches are a future extension.
        key: string,
        /// `some(_)` for `add` and `replace`; `none` for `remove`.
        value: option<value>,
    }

    /// A structured description of the user's intended change to a resource.
    ///
    /// Each `patch-op` corresponds to a key the user explicitly specified or
    /// removed in the desired state. Fields the user has never specified do
    /// not appear in the patch. Providers MUST NOT modify any attribute that
    /// is not represented in `ops`.
    record update-patch {
        ops: list<patch-op>,
    }

    /// Per-operation request record for `provider.create`.
    record create-request {
        /// Full desired state for the new resource. Named `res` because
        /// `resource` is a reserved keyword in WIT.
        res: resource-def,
    }

    /// Per-operation request record for `provider.read`.
    ///
    /// Has no operationally meaningful fields today; the record exists so
    /// future fields (e.g. a freshness hint or an attribute projection)
    /// can be added without breaking the `read` signature. The single
    /// `reserved` field is a placeholder because the wasm component model
    /// rejects records with zero fields — providers MUST ignore it.
    record read-request {
        reserved: bool,
    }

    /// Per-operation request record for `provider.update`.
    ///
    /// `current` is the current provider-side state; `patch` is the user's
    /// intended changes only. The patch is the sole source of truth for
    /// what the provider should write — there is no separate `to: resource`
    /// because exposing the full desired resource invites providers to
    /// touch fields the user never specified (the root cause of
    /// `carina-rs/carina#2559`).
    ///
    /// Named `current` rather than `from` because `from` is a reserved
    /// keyword in WIT.
    record update-request {
        current: state,
        patch: update-patch,
    }

    /// Per-operation request record for `provider.delete`.
    ///
    /// `directives` carries the resource's Carina-side directives
    /// (force-delete, create-before-destroy, prevent-destroy). Wrapping
    /// it in a record lets future fields be added without breaking the
    /// `delete` signature.
    record delete-request {
        directives: directives,
    }

    /// Carina-side directives for a resource.
    ///
    /// These are instructions to Carina about how to handle the
    /// resource, not metadata about the resource itself. New fields
    /// (e.g. `ignore-changes`, `replace-triggered-by`) are non-breaking
    /// record extensions. Mirrors `carina_core::resource::Directives`.
    record directives {
        /// Force-delete the resource on `delete` (e.g. non-empty S3
        /// buckets, IAM users with attached policies).
        force-delete: bool,
        /// Create the new resource before destroying the old one during
        /// replacement.
        create-before-destroy: bool,
        /// Reject `delete` operations entirely; surfaces a
        /// `prevent-destroy` provider-error instead of attempting the
        /// API call.
        prevent-destroy: bool,
    }

    /// Structured identity of a provider-defined custom type.
    ///
    /// Replaces the flat dotted/snake-cased type-name string previously
    /// passed to `validate-custom-type`. Carrying the axes as discrete
    /// fields keeps two providers' same-named types distinct
    /// (`aws.Region` vs `gcp.Region`) without the host or plugin having
    /// to split a string apart and re-classify the segments.
    ///
    /// Identity equality is per-axis: two identities denote the same
    /// type iff every *populated* axis is equal. An empty axis means
    /// "not distinguished on this axis" — a wider type, higher in the
    /// base chain — not a wildcard.
    ///
    /// Mirrors `carina_core`'s structured type identity. The dotted
    /// display form (`aws.iam.Role.Arn`) is derived from this record,
    /// never the source of truth.
    record type-identity {
        /// Provider segment, e.g. `"aws"`. Empty string when the type
        /// carries no provider axis (a truly provider-agnostic wrapper).
        provider: string,
        /// Service / resource segments between the provider and the
        /// kind, e.g. `["iam", "Role"]` for `aws.iam.Role.Arn`. Empty
        /// for a provider-scoped but resource-agnostic type such as the
        /// generic `aws.Arn`.
        segments: list<string>,
        /// The type's own name, e.g. `"Arn"`, `"VpcId"`, `"Region"`.
        kind: string,
    }

    /// Structured error returned by every provider operation.
    ///
    /// Variants are mutually exclusive — host code can match exhaustively
    /// to dispatch retry / abort / not-found / escalate strategies in a
    /// type-safe way. Each variant carries an `error-detail` with the
    /// human-readable message and contextual fields (`resource-id`,
    /// `cause`, `provider-name`).
    variant provider-error {
        /// User-supplied input is invalid (bad attribute value, schema
        /// violation, configuration mismatch). Not retriable.
        invalid-input(error-detail),
        /// The cloud API rejected the request (HTTP 4xx/5xx, server-side
        /// error). May be retriable depending on the cause; the host
        /// inspects `error-detail.cause` for further classification.
        api-error(error-detail),
        /// Resource was not found at the cloud API. `read` returns this
        /// instead of an empty state when the underlying resource has
        /// been deleted out-of-band. `delete` returns this when the
        /// resource is already gone.
        not-found(error-detail),
        /// Operation timed out before completing. Retriable with
        /// backoff.
        timeout(error-detail),
        /// Provider-internal failure (panic, unexpected state, missing
        /// schema entry, etc.). Should be escalated as a bug rather
        /// than retried.
        internal(error-detail),
    }

    /// Contextual metadata attached to every `provider-error` variant.
    ///
    /// Fields mirror the existing `carina_core::provider::ProviderError`
    /// host-side struct. The `cause` chain is flattened to a string
    /// because WIT cannot represent `dyn std::error::Error`.
    ///
    /// The `operation` / `status` / `code` / `request-id` quartet
    /// carries cloud-API metadata in a cloud-agnostic shape so the host
    /// can render a multi-line, labeled error display without each
    /// provider doing its own ad-hoc string formatting. AWS providers
    /// populate them from the SDK's `ProvideErrorMetadata` trait;
    /// future GCP/Azure providers can use the same fields (status =
    /// HTTP, code = string identifier, request-id = correlation id).
    /// All four are optional — non-cloud providers leave them empty.
    /// See carina-rs/carina#3242 for the full design rationale.
    record error-detail {
        /// Human-readable message.
        message: string,
        /// Resource the error pertains to, if known.
        resource-id: option<resource-id>,
        /// Flattened representation of the underlying cause chain, if
        /// any. Empty when the error has no upstream cause.
        cause: option<string>,
        /// Provider name (e.g. `aws`, `awscc`) when the error is
        /// raised at provider-init / `create-provider` boundary points
        /// where the name is known but no specific resource is in
        /// scope.
        provider-name: option<string>,
        /// Service-qualified API operation that failed, e.g.
        /// `iam.ListRoles`, `s3.HeadBucket`. Optional because not
        /// every error originates from a single named API call.
        operation: option<string>,
        /// HTTP status code from the cloud-API response, when the
        /// error came from an HTTP-based service call.
        status: option<u16>,
        /// Application-level error code returned by the cloud API,
        /// e.g. `AccessDenied`, `NoSuchBucket`. Distinct from
        /// `status` — multiple codes can share a status (HTTP 403 can
        /// be `AccessDenied`, `InvalidAccessKeyId`,
        /// `SignatureDoesNotMatch`, etc.) and the code is what makes
        /// the actionable diagnosis.
        code: option<string>,
        /// Correlation id from the cloud-API response (AWS
        /// `x-amzn-RequestId`, GCP `X-Goog-Request-Id`, Azure
        /// `x-ms-request-id`, …). Operators paste this into support
        /// tickets to let the provider look up server-side logs.
        request-id: option<string>,
    }

    /// Binding-name pattern used by `satisfier-hint` to declare which
    /// neighbor effects in a plan can mutate a wait's observed attribute.
    /// The planner matches every pattern against the plan's binding names
    /// at plan time.
    variant binding-pattern {
        /// Match a binding by exact name.
        exact(string),
        /// Match every expanded child of a for-loop binding `<base>`;
        /// i.e. every binding whose name starts with `<base>[`.
        for-loop-children(string),
        /// Match every binding of a given resource type whose attribute
        /// `attr` references the target's attribute at `from`. This is the
        /// pattern ACM's `Certificate` uses to point at the
        /// `route53.RecordSet` entries whose `name` comes from
        /// `target.domain-validation-options[*].resource-record.name`.
        ///
        /// `attr` and `from` are dotted attribute paths.
        attribute-match(attribute-match-pattern),
    }

    record attribute-match-pattern {
        resource-type: string,
        attr: list<string>,
        %from: list<string>,
    }
}
